{
  "_about": "Model catalog for the router (motion-kit/scripts/route.mjs). Capabilities come from each tool's own MCP tool descriptions as seen in this repo's sessions; 'verified' says where. Cost is a RELATIVE tier (1 = cheapest), never a price: always preflight with the tool's cost check (Higgsfield: get_cost:true; Magnific: simulate_cost) before spending. Re-check with models_explore / the tool's model list before relying on any entry; catalogs change monthly. Providers: higgsfield and magnific (MCP, paid credits), local (open weights on the user's GPU), free (Claude + CPU in this repo).",
  "updated": "2026-10-10",
  "providers": {
    "higgsfield": {
      "mcp": "mcp__higgsfield__*",
      "verified": "tool descriptions read in session 2026-10-10 (generate_image, generate_video, generate_audio, manage_reference_elements, upscale_image, remove_background)",
      "cost_check": "params.get_cost: true (not available inside *_batch)",
      "free_allowance": "server returns unlim_choice when a free-trial allowance covers the model; ask the user, never set use_unlim yourself",
      "consistency": "Reference elements: create once from one clear image, then put <<<element_id>>> in prompts. Honoured by the models marked elements:true. kling3_0 also needs a start_image.",
      "notes": "Seedance, Kling, MiniMax, Veo-class and GPT/Nano Banana image models are served through Higgsfield, so one MCP connection covers most of the model landscape."
    },
    "magnific": {
      "mcp": "mcp__magnific__*",
      "verified": "tool list and video_models_list read in session 2026-10-10. Video slugs from video_models_list; image slugs from the images_generate tool description (trap: imagen-nano-banana-2 is Nano Banana PRO, imagen-nano-banana-2-flash is Nano Banana 2).",
      "cost_check": "simulate_cost (read-only) before any generate call; account_balance for credits",
      "consistency": "reference images in video_generate / images_generate; brand_kit_* for brand rules",
      "notes": "Covers video, image, TTS, SFX, music, Foley (video_soundfx), lip-sync (video_speak), upscale/relight. Sign-in can expire: the user re-signs in the Magnific panel."
    },
    "local": {
      "how": "Open weights on the user's own GPU (ComfyUI, Wan2GP, diffusers) or a free Colab / Hugging Face Space. npm run produce --tier local writes the job sheet; results come back as files.",
      "verified": "web research 2026-10-10 (docs/research/free-open-models.md); not run in this repo's GPU-less container",
      "cost_check": "none: GPU time only. Check each model card's licence for client work (several exclude regions or need attribution).",
      "consistency": "character LoRA (Wan 2.2), H3 Ref2VA references, same voice reference clip + seed for TTS"
    },
    "free": {
      "how": "Claude Code + CPU only: motion-kit code scenes, Kokoro voices, tools/sfx_synth.py, tools/music_bed.py",
      "verified": "built and run in this repo",
      "cost_check": "none",
      "consistency": "same Kokoro voice per character; plates fall back to each plate's code scene"
    }
  },
